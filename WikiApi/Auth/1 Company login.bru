meta {
  name: 1 Company login
  type: http
  seq: 1
}

post {
  url: {{userUrl}}?action=rootLogin
  body: json
  auth: none
}

body:json {
  {
    "username": "{{companyUsername}}",
    "password": "{{companyPassword}}"
  }
}

docs {
