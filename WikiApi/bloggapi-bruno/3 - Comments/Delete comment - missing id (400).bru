meta {
  name: Delete comment - missing id (400)
  type: http
  seq: 10
}

delete {
  url: {{baseUrl}}?action=deleteComment
  body: json
  auth: none
}

params:query {
  action: deleteComment
}

headers {
  X-User-Token: {{token}}
}

body:json {
  {
    "comment_id": 0
  }
}

assert {
  res.status: eq 400
  res.body.status: eq error
}
