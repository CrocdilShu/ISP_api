meta {
  name: Delete comment
  type: http
  seq: 9
}

delete {
  url: {{baseUrl}}?action=deleteComment
  body: json
  auth: none
}

params:query {
  action: deleteComment
}

headers {
  X-User-Token: {{token}}
}

body:json {
  {
    "comment_id": "{{commentId}}"
  }
}

assert {
  res.status: eq 200
  res.body.status: eq success
}
