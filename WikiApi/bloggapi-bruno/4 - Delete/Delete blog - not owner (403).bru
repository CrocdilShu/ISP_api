meta {
  name: Delete blog - not owner (403)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}?action=deleteBlog
  body: json
  auth: none
}

params:query {
  action: deleteBlog
}

headers {
  X-User-Token: {{token2}}
}

body:json {
  {
    "blog_id": "{{blogId}}"
  }
}

assert {
  res.status: eq 403
  res.body.status: eq error
}
